{
  "name": "devflow",
  "version": "1.0.0",
  "description": "An open-source, agile project management platform with local Git integration.",
  "author": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"FRONT,BACK\" -c \"cyan,magenta\" \"vite\" \"node --watch server/index.js\"",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$ports = @(3000,3001,4173); $connections = Get-NetTCPConnection -State Listen -LocalPort $ports -ErrorAction SilentlyContinue; $usedPorts = @($connections | Select-Object -ExpandProperty LocalPort -Unique | Sort-Object); $pids = @($connections | Select-Object -ExpandProperty OwningProcess -Unique); if ($pids.Count -gt 0) { Stop-Process -Id $pids -Force; Write-Host ('Stopped processes on ports ' + ($usedPorts -join ', ')); } else { Write-Host 'No listening processes found on ports 3000, 3001 and 4173.' }\"",
    "build": "vite build",
    "preview": "concurrently --kill-others-on-fail -n \"FRONT,BACK\" -c \"cyan,magenta\" \"vite preview\" \"node server/index.js\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "eslint . --fix --report-unused-disable-directives",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.475.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.3",
    "eslint": "^10.7.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
